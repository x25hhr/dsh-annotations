{
  "name": "dsh-annotations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "划词注释：选中回答中的文字，按 重要/疑问/否定/补充 分类标注，并一键汇总插入输入框继续追问。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "annotations",
    "notes",
    "chat-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/x25hhr/dsh-annotations.git"
  },
  "homepage": "https://github.com/x25hhr/dsh-annotations"
}
